  },
  "dependencies": {
    "cpu-benchmark": "^1.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "systeminformation": "^5.33.19"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    },
    "minimatch": "^11.0.4"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
